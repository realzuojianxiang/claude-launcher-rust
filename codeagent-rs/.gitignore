# 忽略构建产物
/target/

# 绝不让 API key 进 git
.env
.env.*
*.key
# 本地 key 明文文件 —— 双保险,防止 git add -A 误提交。
# 真实 key 永远只在环境变量里,此文件不应存在/不应入库。
code-agent-apikey.txt

# 本地调试输出
*.log

# P0.5: 真实配置文件(含你启用的 provider 段)。
# 虽设计上不含真 key(只存 env 名),仍不入库 —— 个人配置不该进版本控制。
# codeagent.toml.example 才是入库分享的范例。
codeagent.toml
codeagent.toml.bak

# IDE 工作区(父 .gitignore 只挡仓库根 /.idea/,个子项目自己挡)
/.idea/

# REPL 运行时副作用文件(本地会话/编辑历史,纯个人数据,不入库)
.codeagent_history
.codeagent_session.json

# 损坏留证产物(P7 session::load 把坏文件改名 .corrupt.* 留现场,非正式数据)
.corrupt.*

# 工具测试副作用文件(P3「写文件→读文件」验证那步产物,不入库)
hello.txt

# P9 真端到端测试环境(testrig)—— 隔离跑 codeagent exe 验 P9-1/P9-2/P9-4
# 真键路径。内容含隔离 codeagent.toml(不含真 key,只 api_key_env)+ 运行产物
# (session/log/stdout 抓取),都是本地一次性数据,不入库。testrig 脚本(.ps1)
# 本身可入库,故只挡 runs/ session/ 与隔离 toml,留 *.ps1 给 git 跟踪。
.e2e/runs/
.e2e/session/
.e2e/codeagent.toml
.e2e/*.log
.e2e/*.out
.e2e/*.err
.e2e/*.txt

# P11 临时实证脚本与 debug trace(P11-1/P11-3 真跑实证 / 一次性脚本与
# stdout 抓取),与上 P9 testrig 同性质 —— 不入库、本地一次性。整目录挡掉
# 比逐扩展名简单(.e2e 已无 tracked 文件),与历史一致「按仅 stage journey 落点
# 而不入脚本」的纪律对齐。
/.e2e/

# codeagent-rs 工作树噪音(跨 session debug 脚手架/真运行 trace/隔离配置):
# 不入库、本地一次性。列单条而非挡 *.txt 全局,防误吞 src/ 或 docs/ 里的真
# 文档(本目录无 .txt 资产,但显式命名更安全可读)。
/_search.ps1
/marker.txt
/dbg-test.txt
/dbg-test2.txt
/leg1.txt
/leg1b.txt
/leg2.txt
/leg2b.txt
/p61-trace.txt
/p94-trace.txt
/resume-marker.txt
/t-build.txt
/t-build2.txt
/t-recall.txt
/t-recall2.txt
/trace-dbg.txt
/turns-strict.txt

# .superpowers/sdd 流程内补文档(探查/评估草稿,非上游 sdd 任务报告):
# 让 git status 静默,与 .superpowers/sdd/.gitignore 的 * 规则精神一致。
# (本目录 tracked docs 内只有 concepts/journey/P5-streaming 三份真资产,
#  assessment 类 tui-* / pi-* 均为流程草稿不入库。)
/docs/tui-integration-assessment.md
/docs/pi-provider-integration-assessment.md

# superpowers/sdd 流程 plan 草稿(Pi 最小 TUI 接入实施计划等),本地一次性
# 规划文档不入库 —— 评估草稿性质,与上同,留本地不污染 status。
/docs/superpowers/
